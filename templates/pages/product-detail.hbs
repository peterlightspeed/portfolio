        <article class="product-detail py-5">
            <div class="container" style="max-width: 860px;">
                <a href="{{url '/products/'}}" class="text-decoration-none small text-muted d-inline-block mb-3"><i class="bi bi-arrow-left me-1"></i>All Products</a>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="product-icon"><i class="bi {{icon}}"></i></div>
                    <div>
                        <h1 class="fw-bold mb-1">{{title}}</h1>
                        <span class="badge bg-light text-dark border">{{badge}}</span>
                    </div>
                </div>
                <p class="lead">{{shortDescription}}</p>

                {{#if image}}
                <img loading="lazy" src="{{asset image}}" alt="{{title}} screenshot" class="img-fluid rounded-3 shadow-sm my-4 product-screenshot-large">
                {{/if}}

                {{#if (eq workType "product")}}<span class="badge bg-primary mb-3">Product</span>{{/if}}

                <div class="d-flex flex-wrap gap-2 mb-3">
                    {{#if links.github}}<a href="{{links.github}}" target="_blank" rel="noopener" class="btn btn-dark btn-sm"><i class="bi bi-github me-1"></i>Source</a>{{/if}}
                    {{#if links.liveDemo}}<a href="{{links.liveDemo}}" target="_blank" rel="noopener" class="btn btn-primary btn-sm"><i class="bi bi-box-arrow-up-right me-1"></i>Try It Live</a>{{/if}}
                </div>

                {{#if problem}}
                <h2 class="h5 fw-bold mt-4">The Problem</h2>
                <p>{{problem}}</p>
                {{/if}}

                {{#if longDescription}}
                <h2 class="h5 fw-bold mt-4">Overview</h2>
                <p>{{longDescription}}</p>
                {{/if}}

                {{#if techStack.length}}
                <div class="d-flex flex-wrap gap-2 my-3">
                    {{#each techStack}}<span class="tech-badge">{{this}}</span>{{/each}}
                </div>
                {{/if}}

                {{#if features.length}}
                <h2 class="h5 fw-bold mt-4">Features</h2>
                <ul>{{#each features}}<li>{{this}}</li>{{/each}}</ul>
                {{/if}}

                {{#if roadmap.length}}
                <h2 class="h5 fw-bold mt-4">Roadmap</h2>
                <ul class="list-unstyled">
                    {{#each roadmap}}<li class="mb-2"><strong>{{stage}}:</strong> {{detail}}</li>{{/each}}
                </ul>
                {{/if}}

                <h2 class="h4 fw-bold mt-5 mb-3">Editions</h2>
                <div class="row g-3">
                    {{#each editions}}
                    <div class="col-md-4">
                        <div class="edition-card h-100 p-3 border rounded-3 {{#if (eq status "available")}}border-success{{/if}} {{#if (eq status "private")}}border-secondary{{/if}}">
                            <h3 class="h6 fw-bold">{{name}}</h3>
                            <ul class="list-unstyled small mb-3">
                                {{#each features}}<li class="mb-1"><i class="bi bi-check2 text-success me-1"></i>{{this}}</li>{{/each}}
                            </ul>
                            <p class="small text-muted mb-2">{{statusLabel}}</p>
                            {{#if cta.href}}
                            <a href="{{url cta.href}}" class="btn btn-sm btn-outline-primary w-100"><i class="bi {{cta.icon}} me-1"></i>{{cta.label}}</a>
                            {{else}}
                            <button class="btn btn-sm btn-outline-secondary w-100" disabled><i class="bi {{cta.icon}} me-1"></i>{{cta.label}}</button>
                            {{/if}}
                        </div>
                    </div>
                    {{/each}}
                </div>

                <hr class="my-5">
                <div class="d-flex justify-content-between">
                    <a href="{{url '/products/'}}" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Products</a>
                    <a href="{{url '/contact.html'}}" class="btn btn-primary btn-sm">Ask a question <i class="bi bi-arrow-right ms-1"></i></a>
                </div>
            </div>
        </article>

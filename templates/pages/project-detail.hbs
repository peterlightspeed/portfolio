        <article class="project-detail py-5">
            <div class="container" style="max-width: 860px;">
                <a href="/projects/" class="text-decoration-none small text-muted d-inline-block mb-3"><i class="bi bi-arrow-left me-1"></i>All Projects</a>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-primary">{{category}}</span>
                    {{#if status}}<span class="badge bg-light text-dark border">{{status}}</span>{{/if}}
                    {{#if date}}<span class="badge bg-light text-dark border">{{date}}</span>{{/if}}
                </div>

                <h1 class="fw-bold mb-3">{{title}}</h1>
                <p class="lead">{{shortDescription}}</p>

                {{#if image}}
                <img src="{{asset image}}" alt="{{title}}" class="img-fluid rounded-3 shadow-sm my-4">
                {{/if}}

                <div class="d-flex flex-wrap gap-2 mb-4">
                    {{#each links.github}}{{/each}}
                    {{#if links.github}}<a href="{{links.github}}" target="_blank" rel="noopener" class="btn btn-dark btn-sm"><i class="bi bi-github me-1"></i>Source</a>{{/if}}
                    {{#if links.liveDemo}}<a href="{{links.liveDemo}}" target="_blank" rel="noopener" class="btn btn-primary btn-sm"><i class="bi bi-box-arrow-up-right me-1"></i>Live Demo</a>{{/if}}
                    {{#if links.video}}<a href="{{links.video}}" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm"><i class="bi bi-play-circle me-1"></i>Video</a>{{/if}}
                </div>

                {{#if github}}
                <p class="small text-muted mb-3">
                    <i class="bi bi-star-fill text-warning me-1"></i>{{github.stars}} stars
                    &nbsp;&middot;&nbsp; {{github.language}}
                    &nbsp;&middot;&nbsp; updated {{formatDate github.updatedAt}}
                </p>
                {{/if}}

                {{#if problem}}
                <h2 class="h4 fw-bold mt-5">The Problem</h2>
                <p>{{problem}}</p>
                {{/if}}

                {{#if solution}}
                <h2 class="h4 fw-bold mt-4">The Solution</h2>
                <p>{{solution}}</p>
                {{/if}}

                {{#if architecture}}
                <h2 class="h4 fw-bold mt-4">Architecture</h2>
                <p>{{architecture}}</p>
                {{/if}}

                {{#if techStack.length}}
                <h2 class="h4 fw-bold mt-4">Tech Stack</h2>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    {{#each techStack}}<span class="tech-badge">{{this}}</span>{{/each}}
                </div>
                {{/if}}

                {{#if features.length}}
                <h2 class="h4 fw-bold mt-4">Features</h2>
                <ul>{{#each features}}<li>{{this}}</li>{{/each}}</ul>
                {{/if}}

                {{#if inProgress}}
                <h2 class="h4 fw-bold mt-4">In Progress</h2>
                <p>{{inProgress}}</p>
                {{/if}}

                {{#if roadmap.length}}
                <h2 class="h4 fw-bold mt-4">Roadmap</h2>
                <ul class="list-unstyled">
                    {{#each roadmap}}<li class="mb-2"><strong>{{stage}}:</strong> {{detail}}</li>{{/each}}
                </ul>
                {{/if}}

                {{#if challenges}}
                <h2 class="h4 fw-bold mt-4">Challenges</h2>
                <p>{{challenges}}</p>
                {{/if}}

                {{#if lessonsLearned}}
                <h2 class="h4 fw-bold mt-4">Lessons Learned</h2>
                <p>{{lessonsLearned}}</p>
                {{/if}}

                {{#if futureImprovements}}
                <h2 class="h4 fw-bold mt-4">Future Improvements</h2>
                <p>{{futureImprovements}}</p>
                {{/if}}

                {{#if caseStudyHtml}}
                <hr class="my-5">
                <h2 class="h4 fw-bold mb-3">Engineering Case Study</h2>
                <div class="case-study-body">{{{caseStudyHtml}}}</div>
                {{/if}}

                <hr class="my-5">
                <div class="d-flex justify-content-between">
                    <a href="/projects/" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Projects</a>
                    <a href="/contact.html" class="btn btn-primary btn-sm">Discuss a similar project <i class="bi bi-arrow-right ms-1"></i></a>
                </div>
            </div>
        </article>

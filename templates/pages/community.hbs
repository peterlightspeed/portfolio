        <section class="page-hero bg-primary text-white text-center py-5">
            <div class="container">
                <h1 class="fw-bold display-6">Community</h1>
                <p class="lead mb-0">{{community.intro}}</p>
            </div>
        </section>

        <section class="py-5">
            <div class="container">
                <div class="row g-4 mb-5">
                    {{#each community.metrics}}
                    <div class="col-6 col-md-3 text-center">
                        {{#if value}}<h3 class="display-6 fw-bold text-primary">{{value}}</h3>{{else}}<i class="bi {{icon}} display-6 text-primary"></i>{{/if}}
                        <p class="text-muted small mb-0">{{label}}</p>
                    </div>
                    {{/each}}
                </div>

                <div class="row g-4">
                    {{#each community.activities}}
                    <div class="col-md-6 col-lg-4">
                        <div class="p-4 border rounded-3 h-100">
                            <i class="bi {{icon}} fs-2 text-{{iconColor}} mb-3 d-block"></i>
                            <h2 class="h6">{{title}}</h2>
                            <p class="small text-muted">{{description}}</p>
                            <a href="{{url href}}" target="_blank" rel="noopener" class="small fw-bold">{{cta}} <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                    {{/each}}
                </div>

                {{#if talks.length}}
                <h2 class="h5 fw-bold mt-5">Talks</h2>
                <div class="row g-3">
                    {{#each talks}}
                    <div class="col-md-6">
                        <div class="p-3 border rounded-3">
                            <strong>{{title}}</strong>
                            <p class="small text-muted mb-1">{{event}} &middot; {{date}}</p>
                            {{#if link}}<a href="{{url link}}" class="small">Watch <i class="bi bi-arrow-right"></i></a>{{/if}}
                        </div>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <p class="text-muted small mt-5">Talks and speaking engagements will appear here automatically once added to <code>data/talks.json</code>.</p>
                {{/if}}
            </div>
        </section>

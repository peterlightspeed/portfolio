        <section class="page-hero bg-primary text-white text-center py-5">
            <div class="container">
                <h1 class="fw-bold display-6">Now</h1>
                <p class="lead mb-0">{{now.headline}}</p>
                <p class="small text-white-50">Last updated {{now.updated}} &middot; inspired by <a href="https://nownownow.com/about" class="text-white" target="_blank" rel="noopener">the /now page movement</a></p>
            </div>
        </section>

        <section class="py-5">
            <div class="container" style="max-width: 760px;">
                <h2 class="h5 fw-bold">Currently Building</h2>
                <div class="row g-3 mb-5">
                    {{#each currentProjects}}
                    <div class="col-md-6">
                        <a href="{{url '/projects/'}}{{slug}}/" class="text-decoration-none">
                            <div class="p-3 border rounded-3 h-100">
                                <strong>{{title}}</strong>
                                <p class="small text-muted mb-0">{{status}}</p>
                            </div>
                        </a>
                    </div>
                    {{/each}}
                </div>

                <h2 class="h5 fw-bold">Currently Learning</h2>
                <div class="d-flex flex-wrap gap-2 mb-5">
                    {{#each now.currentlyLearning}}<span class="tech-badge tech-badge-learning">{{this}}</span>{{/each}}
                </div>

                {{#if now.goals.length}}
                <h2 class="h5 fw-bold">Current Goals</h2>
                <ul class="mb-5">{{#each now.goals}}<li>{{this}}</li>{{/each}}</ul>
                {{/if}}

                {{#if now.books.length}}
                <h2 class="h5 fw-bold">Reading</h2>
                <ul class="mb-5">{{#each now.books}}<li>{{this}}</li>{{/each}}</ul>
                {{/if}}

                {{#if now.upcomingPlans.length}}
                <h2 class="h5 fw-bold">Upcoming Plans</h2>
                <ul class="mb-5">{{#each now.upcomingPlans}}<li>{{this}}</li>{{/each}}</ul>
                {{/if}}

                <p class="text-muted small">This page is generated from <code>data/now.json</code> — edit that one file to keep it current.</p>
            </div>
        </section>

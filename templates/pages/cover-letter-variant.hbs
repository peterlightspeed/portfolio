        <section class="py-5">
            <div class="container resume-container">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 no-print">
                    <div>
                        <a href="{{url '/cover-letters/'}}" class="small d-block mb-1"><i class="bi bi-arrow-left me-1"></i>All roles</a>
                        <h1 class="h4 mb-0">{{l.label}} Cover Letter</h1>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary btn-sm" id="copyLetterBtn" type="button" data-track="cover-letter-copy" data-track-label="{{l.slug}}">
                            <i class="bi bi-clipboard me-1"></i>Copy text
                        </button>
                        <button class="btn btn-outline-primary btn-sm" onclick="window.print()" type="button">
                            <i class="bi bi-printer me-1"></i>Print / Save as PDF
                        </button>
                        <a href="{{url l.resumeHref}}" class="btn btn-primary btn-sm">Matching resume</a>
                    </div>
                </div>

                <article class="resume-sheet cover-letter" id="letterBody">
                    <p class="mb-1"><strong>{{site.name}} Toluwanimi</strong></p>
                    <p class="small text-muted">{{site.email}} &nbsp;&middot;&nbsp; {{site.location.country}}</p>
                    <p>{{l.date}}</p>
                    <p>{{l.greeting}}</p>
                    {{#each l.paragraphs}}<p>{{this}}</p>{{/each}}
                    <p class="mb-1">{{l.signOff}}</p>
                    <p><strong>{{site.name}} Toluwanimi</strong></p>
                </article>
                <p class="small text-muted mt-3 no-print">Replace every <strong>[bracketed]</strong> token before sending.</p>
            </div>
        </section>
        <script>
        (function () {
            var btn = document.getElementById('copyLetterBtn');
            var body = document.getElementById('letterBody');
            if (!btn || !body || !navigator.clipboard) { if (btn) btn.hidden = true; return; }
            btn.addEventListener('click', function () {
                navigator.clipboard.writeText(body.innerText).then(function () {
                    btn.textContent = 'Copied';
                    setTimeout(function () { btn.innerHTML = '<i class="bi bi-clipboard me-1"></i>Copy text'; }, 1800);
                });
            });
        })();
        </script>

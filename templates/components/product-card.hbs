<div class="col-lg-6 product-item" data-slug="{{slug}}"{{#if hidden}} hidden{{/if}}>
    <div class="card product-card shadow-sm h-100">
        {{#if image}}
        <img loading="lazy" src="{{asset image}}" class="card-img-top product-screenshot" alt="{{title}} screenshot">
        {{/if}}
        <div class="card-body">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="product-icon"><i class="bi {{icon}}"></i></div>
                <div>
                    <h2 class="h4 fw-bold mb-1 d-flex align-items-center gap-2">{{title}}</h2>
                    <span class="badge bg-light text-dark border">{{badge}}</span>
                </div>
            </div>
            <p class="mb-4">{{shortDescription}}</p>

            <div class="row g-3">
                {{#each editions}}
                <div class="{{colFor ../editions.length}}">
                    <div class="edition-card h-100 p-3 border rounded-3 {{#if (eq status "available")}}border-success{{/if}}">
                        <h3 class="h6 fw-bold">{{name}}</h3>
                        <ul class="list-unstyled small mb-3">
                            {{#each features}}<li class="mb-1"><i class="bi bi-check2 text-success me-1"></i>{{this}}</li>{{/each}}
                        </ul>
                        <p class="small text-muted mb-2">{{statusLabel}}</p>
                        {{#if cta.href}}
                        <a href="{{url cta.href}}" class="btn btn-sm btn-outline-primary w-100" target="_blank" rel="noopener">
                            <i class="bi {{cta.icon}} me-1"></i>{{cta.label}}
                        </a>
                        {{else}}
                        <button class="btn btn-sm btn-outline-secondary w-100" disabled>
                            <i class="bi {{cta.icon}} me-1"></i>{{cta.label}}
                        </button>
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>
            <div class="mt-3">
                <a href="{{url '/products/'}}{{slug}}/" class="btn btn-link px-0">Full product details <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

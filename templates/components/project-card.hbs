<div class="col-md-6 col-lg-4 project-item" data-category="{{category}}" data-tags="{{#each tags}}{{this}} {{/each}}">
    <div class="card shadow-sm h-100 project-card">
        {{#if image}}
        <img loading="lazy" src="{{asset image}}" class="card-img-top" alt="{{title}}">
        {{else}}
        <div class="card-img-top project-image-placeholder d-flex align-items-center justify-content-center">
            <i class="bi bi-code-square display-3 text-primary"></i>
        </div>
        {{/if}}
        <div class="project-badge bg-primary text-white">{{category}}</div>
        <div class="card-body d-flex flex-column">
            <h3 class="card-title h5"><a href="{{url '/projects/'}}{{slug}}/" class="stretched-link-title">{{title}}</a></h3>
            <p class="card-description">{{shortDescription}}</p>
            <div class="tech-stack mb-2">
                {{#each techStack}}<span class="tech-badge">{{this}}</span>{{/each}}
            </div>
            <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                <a href="{{url '/projects/'}}{{slug}}/" class="btn btn-primary btn-sm">
                    <i class="bi bi-arrow-right-circle me-1"></i>View Project
                </a>
                {{#if status}}<small class="text-muted">{{status}}</small>{{/if}}
            </div>
        </div>
    </div>
</div>

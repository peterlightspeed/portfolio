    <footer class="footer-section bg-dark text-light pt-5 pb-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h3 class="h5 fw-bold text-white mb-3">{{site.name}}</h3>
                    {{#if (eq site.availability.status "available")}}
                    <p class="mb-2"><span class="availability-badge availability-badge-footer"><span class="availability-dot"></span>{{site.availability.label}}</span></p>
                    <p class="text-light small mb-2">{{site.availability.responseTime}}</p>
                    {{/if}}
                    <p class="text-light small">{{site.shortBio}}</p>
                    <div class="d-flex gap-3 mt-3 social-icons">
                        {{#each site.socials}}
                        <a href="{{this.url}}" class="text-light fs-5" target="_blank" rel="noopener" aria-label="{{this.label}}"><i class="bi {{this.icon}}"></i></a>
                        {{/each}}
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <h4 class="h6 fw-bold text-white mb-3">Navigate</h4>
                    <ul class="list-unstyled">
                        {{#each site.primaryNav}}
                        <li class="mb-2"><a class="footer-link" href="{{url this.href}}">{{this.label}}</a></li>
                        {{/each}}
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4 col-6">
                    <h4 class="h6 fw-bold text-white mb-3">Services</h4>
                    <ul class="list-unstyled">
                        {{#each site.footerServices}}
                        <li class="mb-2"><a class="footer-link" href="{{url this.href}}">{{this.label}}</a></li>
                        {{/each}}
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4">
                    <h4 class="h6 fw-bold text-white mb-3">Get in Touch</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a class="footer-link" href="mailto:{{site.email}}"><i class="bi bi-envelope-fill me-2"></i>{{site.email}}</a></li>
                        <li class="mb-2"><a class="footer-link" href="{{site.whatsapp}}" target="_blank" rel="noopener"><i class="bi bi-whatsapp me-2"></i>WhatsApp</a></li>
                        <li class="mb-2 text-light-emphasis"><i class="bi bi-geo-alt-fill me-2"></i>{{site.location.city}}, {{site.location.country}}</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary mt-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-light-emphasis">
                <p class="mb-2 mb-md-0">&copy; {{year}} {{site.name}}. All rights reserved.</p>
                <div>
                    <a href="#" class="footer-link me-3" data-bs-toggle="modal" data-bs-target="#privacyModal">Privacy Policy</a>
                    <a href="#" class="footer-link me-3" data-bs-toggle="modal" data-bs-target="#termsModal">Terms of Service</a>
                    <a href="#main-content" class="footer-link">Back to Top</a>
                </div>
            </div>
        </div>
    </footer>

    <button id="backToTop" class="back-to-top" aria-label="Back to top"><i class="bi bi-arrow-up"></i></button>
